{
  "info": {
    "name": "Banco XYZ BFF - Semana 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"cuentaId","value":"101"}
  ],
  "item": [
    {
      "name": "BFF Web - Dashboard",
      "request": {
        "method": "GET",
        "header": [{"key":"X-CHANNEL-TOKEN","value":"web-xyz-2026"}],
        "url": "{{baseUrl}}/api/bff/web/cuentas/{{cuentaId}}/dashboard"
      }
    },
    {
      "name": "BFF Mobile - Resumen",
      "request": {
        "method": "GET",
        "header": [{"key":"X-CHANNEL-TOKEN","value":"mobile-xyz-2026"}],
        "url": "{{baseUrl}}/api/bff/mobile/cuentas/{{cuentaId}}/resumen"
      }
    },
    {
      "name": "BFF ATM - Saldo",
      "request": {
        "method": "GET",
        "header": [
          {"key":"X-CHANNEL-TOKEN","value":"atm-xyz-2026"},
          {"key":"X-ATM-ID","value":"ATM-001"}
        ],
        "url": "{{baseUrl}}/api/bff/atm/cuentas/{{cuentaId}}/saldo"
      }
    },
    {
      "name": "BFF ATM - Retiro",
      "request": {
        "method": "POST",
        "header": [
          {"key":"Content-Type","value":"application/json"},
          {"key":"X-CHANNEL-TOKEN","value":"atm-xyz-2026"},
          {"key":"X-ATM-ID","value":"ATM-001"}
        ],
        "body": {"mode":"raw","raw":"{\n  \"monto\": 100\n}"},
        "url": "{{baseUrl}}/api/bff/atm/cuentas/{{cuentaId}}/retiros"
      }
    },
    {
      "name": "Seguridad - Token Web incorrecto",
      "request": {
        "method": "GET",
        "header": [{"key":"X-CHANNEL-TOKEN","value":"token-incorrecto"}],
        "url": "{{baseUrl}}/api/bff/web/cuentas/{{cuentaId}}/dashboard"
      }
    }
  ]
}
